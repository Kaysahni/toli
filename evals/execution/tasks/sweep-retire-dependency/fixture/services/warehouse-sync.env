# warehouse-sync: mirrors WMS stock positions into the data warehouse every 15 minutes
# owner: Warehouse Tech
WMS_API=https://wms-gw.warehouse.tesselwick.internal/api/stock
WMS_CLIENT_ID=warehouse-sync
WMS_CLIENT_SECRET=vault:kv/prod/warehouse-sync#secret
WAREHOUSE_DSN=vault:kv/prod/warehouse-sync#dsn
TARGET_SCHEMA=wms
SITES=ORB,KLV,HSK
INTERVAL_SECONDS=900
