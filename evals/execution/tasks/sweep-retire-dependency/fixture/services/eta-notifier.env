# eta-notifier production environment
# Owner: Customer Comms squad (#cc-eta). Pager: cc-eta-primary
# Rendered from vault path kv/prod/eta-notifier on deploy. Do not edit on the box.

APP_ENV=production
LOG_LEVEL=warn
HTTP_PORT=8080

# where shipment updates come from
KAFKA_BROKERS=kafka-a1.stream.tesselwick.internal:9093,kafka-a2.stream.tesselwick.internal:9093
KAFKA_TOPIC_IN=shipment.milestone
KAFKA_GROUP=eta-notifier-prod

# recompute arrival windows when a milestone slips
ROUTE_HOST=pathfinder-old.tsw.internal
ROUTE_PATH=/quote
ROUTE_TIMEOUT_MS=3000

# outbound messaging
NOTIFY_GATEWAY_URL=http://notify-gateway.comms.svc:8080/send
SMS_SENDER_ID=TESSELWICK
EMAIL_FROM=updates@tesselwick.example
QUIET_HOURS_START=21
QUIET_HOURS_END=7

REDIS_URL=redis://redis-comms.cache.tesselwick.internal:6379/4
DEDUPE_WINDOW_SECONDS=900

SENTRY_DSN=vault:kv/prod/eta-notifier#sentry_dsn
