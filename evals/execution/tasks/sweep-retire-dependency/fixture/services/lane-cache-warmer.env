# lane-cache-warmer: pre-populates RouteCache for the top 5,000 lanes every morning
# owner: Platform Performance (Signe Halvorsen)
ENV=prod
ROUTECACHE_URL=https://routecache.core.tesselwick.internal/v1
ROUTECACHE_WRITE_TOKEN=vault:kv/prod/lane-cache-warmer#token
TOP_LANES_QUERY_FILE=/etc/warmer/top_lanes.sql
WAREHOUSE_DSN=vault:kv/prod/lane-cache-warmer#warehouse
CONCURRENCY=24
START_AT_LOCAL=04:30
TZ=Europe/Stockholm
