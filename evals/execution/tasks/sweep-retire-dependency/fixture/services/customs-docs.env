# customs-docs: generates export declarations and T1 transit documents
# owner: Trade Compliance Engineering (Elif Kaya)
APP_ENV=prod
HTTP_PORT=8000
DOC_TEMPLATES_DIR=/app/templates
CUSTOMS_BROKER_API=https://broker-link.partners.tesselwick.internal/api
TARIC_SNAPSHOT=2026-07
SHIPMENTS_DB_DSN=vault:kv/prod/customs-docs#shipments_ro
SIGNING_KEY=vault:kv/prod/customs-docs#signing_key
ARCHIVE_BUCKET=s3://tw-customs-archive
# border crossing lookup table, updated quarterly
BORDER_POINTS_FILE=/app/data/border_points_2026q3.csv
